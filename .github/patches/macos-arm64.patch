diff --git a/scripts/package-macos.py b/scripts/package-macos.py
new file mode 100755
index 0000000..5cffe9c
--- /dev/null
+++ b/scripts/package-macos.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Build a macOS .app bundle for the host architecture and matching rebuildable sources."""
+
+import os
+import platform
+import runpy
+import shutil
+import subprocess
+import sys
+import tempfile
+import tomllib
+import zipfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+ARCHITECTURES = {
+    "arm64": ("arm64", "aarch64-apple-darwin"),
+    "aarch64": ("arm64", "aarch64-apple-darwin"),
+    "x86_64": ("x86_64", "x86_64-apple-darwin"),
+    "amd64": ("x86_64", "x86_64-apple-darwin"),
+}
+
+
+def main():
+    machine = platform.machine().lower()
+    if sys.platform != "darwin" or machine not in ARCHITECTURES:
+        raise SystemExit("macOS packaging requires a native macOS host.")
+    architecture, target = ARCHITECTURES[machine]
+    version = tomllib.loads((ROOT / "Cargo.toml").read_text(encoding="utf-8"))[
+        "package"
+    ]["version"]
+    name = f"xuan-{version}-macos-{architecture}"
+    destination = ROOT / "dist"
+    destination.mkdir(exist_ok=True)
+
+    env = os.environ.copy()
+    env.pop("CARGO_ENCODED_RUSTFLAGS", None)
+    target_directory = ROOT / "target"
+    subprocess.run(
+        [
+            "cargo",
+            "build",
+            "--release",
+            "--target",
+            target,
+            "--target-dir",
+            str(target_directory),
+        ],
+        cwd=ROOT,
+        env=env,
+        check=True,
+    )
+
+    with tempfile.TemporaryDirectory(prefix=".macos-", dir=destination) as directory:
+        stage = Path(directory) / name
+        stage.mkdir()
+        app = stage / "Xuan.app"
+        contents = app / "Contents"
+        macos_dir = contents / "MacOS"
+        resources = contents / "Resources"
+        macos_dir.mkdir(parents=True)
+        resources.mkdir(parents=True)
+        binary = macos_dir / "xuan"
+        shutil.copy2(target_directory / target / "release/xuan", binary)
+        binary.chmod(0o755)
+        licenses = resources / "share/licenses/xuan"
+        licenses.mkdir(parents=True)
+        for filename in (
+            "LICENSE",
+            "licenses/rawler-LGPL-2.1.txt",
+            "licenses/heic-rs-MIT.txt",
+            "licenses/tabler-icons-MIT.txt",
+            "assets/fonts/Inter-LICENSE.txt",
+            "assets/fonts/DroidSansFallback-LICENSE.txt",
+        ):
+            shutil.copy2(ROOT / filename, licenses / Path(filename).name)
+        (licenses / "egui-winit").mkdir()
+        for filename in ("LICENSE-MIT", "LICENSE-APACHE"):
+            shutil.copy2(
+                ROOT / "vendor/egui-winit" / filename,
+                licenses / "egui-winit" / filename,
+            )
+        subprocess.run(
+            [
+                sys.executable,
+                str(ROOT / "scripts/package-docs.py"),
+                str(resources / "share/doc/xuan"),
+                version,
+            ],
+            check=True,
+        )
+        info_plist = contents / "Info.plist"
+        info_plist.write_text(
+            f"""<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+    <key>CFBundleName</key>
+    <string>Xuan</string>
+    <key>CFBundleDisplayName</key>
+    <string>Xuan</string>
+    <key>CFBundleIdentifier</key>
+    <string>com.silverl.xuan</string>
+    <key>CFBundleVersion</key>
+    <string>{version}</string>
+    <key>CFBundleShortVersionString</key>
+    <string>{version}</string>
+    <key>CFBundleExecutable</key>
+    <string>xuan</string>
+    <key>CFBundlePackageType</key>
+    <string>APPL</string>
+    <key>NSHighResolutionCapable</key>
+    <true/>
+</dict>
+</plist>
+""",
+            encoding="utf-8",
+        )
+        package = destination / f"{name}.zip"
+        with zipfile.ZipFile(package, "w", compression=zipfile.ZIP_DEFLATED) as archive:
+            for path in sorted(app.rglob("*")):
+                if path.is_file():
+                    archive.write(path, path.relative_to(stage).as_posix())
+
+    source_packager = runpy.run_path(str(ROOT / "scripts/package-source.py"))
+    source_packager["write_checksum"](package)
+    source_packager["main"]()
+    print(f"Created {package}")
+
+
+if __name__ == "__main__":
+    main()

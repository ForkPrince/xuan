+def windows_architecture():
+    """Return the Windows package name suffix and PE machine for this host."""
+    machine = platform.machine().lower()
+    if machine in ("amd64", "x86_64"):
+        return "x86_64", 0x8664
+    if machine in ("arm64", "aarch64"):
+        return "arm64", 0xAA64
+    raise ValueError(f"Unsupported Windows host architecture: {platform.machine()}")
+
+
